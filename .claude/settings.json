  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gezu_guard.py\" session" } ] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__.*", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gezu_guard.py\" pre" } ] }
    ],
    "PostToolUse": [
      { "matcher": "mcp__Shopify__graphql_mutation", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gezu_guard.py\" post" } ] }
    ]
  }
